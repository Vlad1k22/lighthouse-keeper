extends RefCounted
## Thirty short, authored shifts. Every action refers to an existing physical station.
static func goal(id: String, title: String, kind: String = "inspect", story: String = "", cost: Dictionary = {}, reward: Dictionary = {}) -> Dictionary:
	return {"id":id,"title":title,"kind":kind,"story":story,"cost":cost,"reward":reward}
static func shift(title: String, brief: String, goals: Array, kind: String, night: String, seconds: float = 15, reward: Dictionary = {}) -> Dictionary:
	return {"title":title,"brief":brief,"goals":goals,"night":{"kind":kind,"text":night,"seconds":seconds},"reward":reward}
static func build() -> Array:

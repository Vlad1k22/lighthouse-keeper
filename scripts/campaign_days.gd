		shift("Первый свет","Обжить остров: найти топливо, зажечь маяк и защитить хижину.",[
			goal("fuel","Забрать канистру на тропе","base"),goal("workbench","Построить укрепление: 3 дерева","base")],"footsteps","За стеной проходят тяжёлые шаги. Включите фонарь и оставайтесь у освещённой хижины.",10),
